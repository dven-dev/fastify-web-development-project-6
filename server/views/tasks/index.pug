extends ../layouts/application.pug

block header
  = t('views.tasks.index.title')

block content
  if isAuthenticated()
    a.btn.btn-primary.mb-3(href=route('newTask'))= t('views.tasks.new.link')
  form.mb-4(action=route('tasks') method='get')
    .row
      .col
        select.form-control(id='data_status' name='filter[status]')
          option(value='')= t('views.tasks.filter.status')
          each status in statuses
            option(value=status.id selected=(filter.status == status.id))= status.name
      .col
        select.form-control(id='data_executor' name='filter[executor]')
          option(value='')= t('views.tasks.filter.executor')
          each user in users
            option(value=user.id selected=(filter.executor == user.id))= `${user.firstName} ${user.lastName}`
      .col
        select.form-control(id='data_label' name='filter[label]')
          option(value='')= t('views.tasks.filter.label')
          each label in labels
            option(value=label.id selected=(filter.label == label.id))= label.name
    .mt-2
      .form-check
        input.form-check-input(type='checkbox' name='filter[isCreatorUser]' id='isCreatorUser' value='1' checked=(filter.isCreatorUser))
        label.form-check-label(for='isCreatorUser')= t('views.tasks.filter.myTasks')
      button.btn.btn-primary.mt-2(type='submit')= t('views.tasks.filter.submit')
  table.table
    thead
      tr
        th= t('views.tasks.id')
        th= t('views.tasks.name')
        th= t('views.tasks.status')
        th= t('views.tasks.creator')
        th= t('views.tasks.executor')
        th= t('views.tasks.createdAt')
        th= t('views.tasks.actions')
    tbody
      each task in tasks
        tr
          td= task.id
          td
            a(href=route('task', { id: task.id }))= task.name
          td= task.status ? task.status.name : ''
          td= task.creator ? `${task.creator.firstName} ${task.creator.lastName}` : ''
          td= task.executor ? `${task.executor.firstName} ${task.executor.lastName}` : ''
          td= formatDate(task.createdAt)
          td
            if isAuthenticated()
              a(href=route('editTask', { id: task.id }))= t('views.tasks.edit.link')
              |  
              if currentUser && currentUser.id === task.creatorId
                +buttonTo(route('deleteTask', { id: task.id }), 'delete')(class="btn btn-link p-0" value=t('views.tasks.delete'))
