extends ../layouts/application.pug

block header
  = t('views.tasks.edit.title')

block content
  +formFor()(action=route('updateTask', { id: task.id }) method='post')
    input(type='hidden' name='_method' value='PATCH')
    +input(task, 'name', errors, 'tasks')(type="text")
    .mb-3
      label(for='data_description')= t('views.tasks.description')
      textarea.form-control(id='data_description' name='data[description]')= task.description
    .mb-3
      label(for='data_statusId')= t('views.tasks.status')
      select.form-control(id='data_statusId' name='data[statusId]')
        option(value='')
        each status in statuses
          option(value=status.id selected=(task.statusId == status.id))= status.name
    .mb-3
      label(for='data_executorId')= t('views.tasks.executor')
      select.form-control(id='data_executorId' name='data[executorId]')
        option(value='')
        each user in users
          option(value=user.id selected=(task.executorId == user.id))= `${user.firstName} ${user.lastName}`
    .mb-3
      label(for='data_labelIds')= t('views.tasks.labels')
      select.form-control(id='data_labelIds' name='data[labelIds][]' multiple)
        each label in labels
          - const selected = task.labels && task.labels.some(l => l.id === label.id)
          option(value=label.id selected=selected)= label.name
    +submit(task)(value=t('views.tasks.edit.submit'))
