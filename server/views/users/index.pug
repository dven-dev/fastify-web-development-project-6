extends ../layouts/application.pug

block header
  = t('views.users.index.title')

block content
  table.table
    thead
      tr
        th= t('views.users.id')
        th= t('views.users.fullName')
        th= t('views.users.email')
        th= t('views.users.createdAt')
        th= t('views.users.actions')
    tbody
      each user in users
        tr
          td= user.id
          td= `${user.firstName} ${user.lastName}`
          td= user.email
          td= formatDate(user.createdAt)
          td
            if currentUser
              a(href=route('editUser', { id: user.id }))= t('views.users.edit.link')
              |  
              +buttonTo(route('deleteUser', { id: user.id }), 'delete')(class="btn btn-link p-0" value=t('views.users.delete'))
